{
  "name": "jovianwear-standalone",
  "version": "1.0.0",
  "description": "Standalone e-commerce platform for Jovian Wear",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "backend": "node backend/server.js",
    "backend:dev": "nodemon backend/server.js",
    "frontend": "cd frontend && python3 -m http.server 3000",
    "build": "npm install && npm run build:frontend",
    "build:frontend": "echo 'Frontend build complete'"
  },
  "keywords": ["ecommerce", "jovianwear"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "stripe": "^13.7.0",
    "multer": "^1.4.5-lts.1",
    "express-validator": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
